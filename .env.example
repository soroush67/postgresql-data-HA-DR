# Copy to .env (or let single/up.sh / cluster/up.sh generate random values).
# Used by both docker-compose files.
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
POSTGRES_REPLICATION_PASSWORD=change-me-replication
APP_DB=appdb
APP_USER=app
APP_PASSWORD=change-me-app
# Host interface the ports are published on (0.0.0.0 = all interfaces)
BIND_ADDRESS=127.0.0.1
# monitoring/up.sh: read-only "monitor" role and Grafana admin
MONITOR_PASSWORD=change-me-monitor
GRAFANA_ADMIN_PASSWORD=change-me-grafana
