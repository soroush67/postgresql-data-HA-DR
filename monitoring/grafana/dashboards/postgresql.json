    "w": 24,
    "x": 0,
    "y": 57
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, sum by (queryid) (rate(pg_stat_statements_seconds_total[5m]))) * on (queryid) group_left (query) max by (queryid, query) (pg_stat_statements_query_id)",
